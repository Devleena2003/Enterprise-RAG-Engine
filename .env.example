# Application
APP_NAME=enterprise-rag-engine
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL (must match above credentials)
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_db
# Embedding & Ingestion
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=16
EMBEDDING_THREADS=2
MAX_UPLOAD_SIZE_MB=20
# Retrieval & Reranking
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false
RERANKER_THREADS=2
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5
MIN_RERANK_SCORE=-2.5
MIN_VECTOR_SCORE=0.55
MAX_CONTEXT_CHARS=6000